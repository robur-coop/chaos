(executable
 (name unikernel)
 (modules unikernel metrics)
 (public_name chaos)
 (package mchaos)
 (modes native)
 (link_flags :standard -cclib "-z solo5-abi=hvt")
 (libraries
  mkernel
  mchaos
  mnet
  mnet-cli
  mnet-dns
  mnet-dns.cli
  mnet-happy-eyeballs
  mnet-happy-eyeballs.cli
  dns
  domain-name
  ipaddr
  mirage-crypto-rng-mkernel
  mirage-ptime.solo5
  cmdliner
  chaos
  chaos.tscclock
  tally-mnet
  logs.fmt
  logs.cli
  fmt.cli)
 (foreign_stubs
  (language c)
  (names manifest.unikernel)))

(rule
 (targets manifest.unikernel.c)
 (enabled_if
  (= %{context_name} "default"))
 (action
  (write-file manifest.unikernel.c "")))

(rule
 (targets manifest.unikernel.c)
 (deps manifest.unikernel.json)
 (enabled_if
  (= %{context_name} "solo5"))
 (action
  (run
   solo5-elftool
   gen-manifest
   manifest.unikernel.json
   manifest.unikernel.c)))

(rule
 (targets manifest.unikernel.json)
 (enabled_if
  (= %{context_name} "solo5"))
 (action
  (with-stdout-to
   manifest.unikernel.json
   (run %{exe:unikernel.exe} --ipv4=0.0.0.0/24))))

(executable
