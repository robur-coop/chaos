opam-version: "2.0"
maintainer: "Robur <team@robur.coop>"
authors: ["Robur <team@robur.coop>"]
homepage: "https://github.com/robur-coop/chaos"
dev-repo: "git+https://github.com/robur-coop/chaos.git"
bug-reports: "https://github.com/robur-coop/chaos/issues"
license: "GPL-2.0-only"

depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.0.0"}
  "mirage-crypto-rng"
  "duration"
  "slice"
  "ipaddr"
  "fmt"
  "ptime"
  "logs"
  "digestif"
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs "--workspace" "dune-workspace.chaos" ]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
synopsis: "A NTP library"
